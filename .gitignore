/target/
**/*.rs.bk
.venv/
__pycache__/
*.so
*.egg-info/
.claude/settings.local.json
*.mp4

# rendered output — the folder is tracked, its contents are not
/results/*
!/results/.gitkeep

# The last of the Rust example tree, never committed and left on disk when the
# rest went. It no longer builds — the facade crate it imports was removed with
# the authoring path — so it is kept out of the way rather than kept working.
/examples/

# API keys for authoring-time tools (Kiri TTS). Never committed.
.env

# Narration for the retired `attention` example: 15MB of audio from a paid API,
# kept only so it need not be bought again. Not ours to publish.
python/examples/attention/audio/

# Examples kept local. `fourier_einstein` traces a copyrighted engraving it
# reads at build time, so the input is not ours to redistribute even though
# the code is; `pypi_nightly` is a one-off announcement clip. Both still run
# and are graded by `tests/run.py --all` like any other example — they are
# simply not published.
python/examples/fourier_einstein/
python/examples/pypi_nightly/

# Frames pulled out of a render while checking it.
/scenes/

# The built documentation site, API reference included. Rebuild with:
#   python docs/build_site.py
/site/
/docs/api/
